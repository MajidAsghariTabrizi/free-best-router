# Free Best Router — environment variables
#
# Copy this file to `.env` and fill in the values you have. Every key is
# optional. The router will start with zero keys, but having at least one
# OpenRouter key dramatically improves the free model pool.
#
# Each provider's key is read from the environment by src/index.mjs. The router
# uses its own credentials and does not validate the inbound Authorization
# header from clients.

# --- OpenRouter (https://openrouter.ai) — primary free-model source ---------
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- OpenCode / Zen (https://opencode.ai) — local install required ----------
# OpenCode Zen must be running on 127.0.0.1:4097 (or change OPENCODE_BASE_URL).
OPENCODE_ZEN_API_KEY=

# --- Groq (https://console.groq.com) — Llama 3.1/3.3 free tier --------------
GROQ_API_KEY=

# --- Cerebras (https://cloud.cerebras.ai) — Llama / Qwen free tier ----------
CEREBRAS_API_KEY=

# --- Mistral (https://console.mistral.ai) — Small / Nemo / Codestral --------
MISTRAL_API_KEY=

# --- DeepSeek (https://platform.deepseek.com) — PAID, excluded by default ---
# Set this only if you want DeepSeek as a non-free fallback (also requires
# setting `routing.policy.paidFallback: true` in config.json).
# DEEPSEEK_API_KEY=

# --- Per-provider HTTP proxy (optional) ------------------------------------
# Useful when a provider's public IP is Cloudflare-blocked from your host.
# Format: http://[user:pass@]host:port  (HTTP proxy only; SOCKS is not supported by undici)
# GROQ_PROXY_URL=
# CEREBRAS_PROXY_URL=
# MISTRAL_PROXY_URL=

# --- General HTTPS proxy (optional) -----------------------------------------
# Applied to all providers that don't set an explicit *_PROXY_URL. Most
# operators should leave this empty. OpenRouter ignores it by design.
# HTTPS_PROXY=

# --- Server bind (optional) -------------------------------------------------
# FREE_ROUTER_PORT=4098
# FREE_ROUTER_CONFIG=/absolute/path/to/config.json
